# ============================================================================
#  OmniRouter — یک روتر برای همه‌ی مدل‌ها / one router for every model
#  First run:  copy this file to .env  →  ./start.sh  (or start.bat)
# ============================================================================

# ── Router core ─────────────────────────────────────────────────────────
# Public port of the router (dashboard + /v1/* API).
PORT=8080

# Client API key for OpenCode / Hermes / Cline / any OpenAI or Anthropic client.
# Leave empty → a random sk-omni-… key is generated on first boot (see dashboard).
# ROUTER_KEY=sk-omni-my-key

# Dashboard admin password.  CHANGE THIS!  / رمز داشبورد — حتماً عوضش کن
ADMIN_PASSWORD=admin

# "auto" model failover chain, best-first (provider/model pairs).
# Default: qwen → deepseek → glm. Override freely:
# AUTO_CHAIN=qwen/qwen3.8-max,ds/deepseek-chat,glm/GLM-5.1

# ── Internal bridge secret (do NOT touch unless you know why) ───────────
# Shared token between the router core and the embedded bridges.
AUTH_TOKEN=omni-internal-change-me

# ── Qwen (chat.qwen.ai) ──────────────────────────────────────────────────
# Optional but recommended: account tokens (cookie "token" from chat.qwen.ai,
# F12 → Application → Cookies). Comma-separated for a multi-account pool.
# QWEN_TOKENS=
# Guest mode (no tokens) works on home IPs; on datacenter/VPS IPs run once:
#   ./qwen-bx        → writes qwen-bx.json next to the binary
# QWEN_BX_FILE=qwen-bx.json

# ── GLM (chat.z.ai) ──────────────────────────────────────────────────────
# Account tokens are optional — guest mode works. chat completions need
# device tokens for the captcha; either provide ZAI_TOKENS, or fill
# tokens.sqlite with the (optional) token-collector tool.
# ZAI_TOKENS=
# GLM_TOKEN_DB=tokens.sqlite

# ── DeepSeek (chat.deepseek.com) — account REQUIRED, no guest mode ───────
# Get a token: run ./ds-login  (or F12 → Console →
#   JSON.parse(localStorage.userToken).value )
# DEEPSEEK_TOKENS=

# ── Agent mode (tools/function-calling shim for Hermes/Cline/OpenCode) ──
AGENT_MODE=1
